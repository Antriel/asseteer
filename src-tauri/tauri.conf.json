{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asseteer",
  "version": "0.2.0",
  "identifier": "com.antriel.asseteer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Asseteer",
        "width": 800,
        "height": 600,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../clap-server/clap_server.py": "clap-server/clap_server.py",
      "../clap-server/clap_test.py": "clap-server/clap_test.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
